{
  "name": "@omnidotdev/sigil-tokens",
  "description": "Omni Sigil design tokens",
  "author": {
    "name": "Omni LLC",
    "url": "https://omni.dev"
  },
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/omnidotdev/sigil-tokens"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./panda": {
      "types": "./build/panda/index.d.ts",
      "import": "./build/panda/index.js"
    }
  },
  "scripts": {
    "build": "bun src/scripts/build.ts",
    "release": "bun run build && changeset publish",
    "verify": "bun src/scripts/verify.ts",
    "snapshot": "bun src/scripts/snapshot.ts",
    "extract": "bun src/scripts/migrate/extract.ts",
    "emit-rust": "bun src/scripts/emit-rust.ts",
    "lint": "bunx tsc --noEmit",
    "prepare": "husky",
    "knip": "knip-bun",
    "check": "biome check"
  },
  "dependencies": {
    "radash": "^12.1.1"
  },
  "peerDependencies": {
    "@pandacss/dev": ">=1.4.3",
    "@pandacss/types": ">=1.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@omnidev/knit": "^0.1.2",
    "@pandacss/dev": "^1.5.0",
    "@pandacss/types": "^1.5.0",
    "@types/bun": "^1.3.8",
    "husky": "^9.1.7",
    "knip": "^5.86.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
